{
  "multipart": [
    {
      "when": {
        "north": "false",
        "east": "false",
        "south": "false",
        "west": "false"
      },
      "apply": {
        "model": "aiarsenal:block/fort_concertina_single"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "aiarsenal:block/fort_concertina_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "aiarsenal:block/fort_concertina_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "aiarsenal:block/fort_concertina_side",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "aiarsenal:block/fort_concertina_side",
        "y": 270
      }
    }
  ]
}