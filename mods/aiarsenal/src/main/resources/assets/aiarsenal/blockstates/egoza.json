{
  "multipart": [
    {
      "when": {
        "north": "false",
        "east": "false",
        "south": "false",
        "west": "false"
      },
      "apply": {
        "model": "aiarsenal:block/field_egoza_single"
      }
    },
    {
      "when": {
        "OR": [
          {
            "north": "true"
          },
          {
            "east": "true"
          },
          {
            "south": "true"
          },
          {
            "west": "true"
          }
        ]
      },
      "apply": {
        "model": "aiarsenal:block/field_egoza_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "aiarsenal:block/field_egoza_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "aiarsenal:block/field_egoza_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "aiarsenal:block/field_egoza_side",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "aiarsenal:block/field_egoza_side",
        "y": 270
      }
    }
  ]
}